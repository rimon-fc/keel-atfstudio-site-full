 "cards": [
  {
   "dot": "emerald",
   "title": "The Loop",
   "items": [
    "Idle and running form the whole happy path",
    "Events posted mid-turn queue behind the current one",
    "Threads are linear; continuing from history forks a new session"
   ]
  },
  {
   "dot": "amber",
   "title": "Waiting Is Not Failure",
   "items": [
    "Background tools and sub-agents park the session",
    "The awaited signal resumes the same turn",
    "Reconnect is subscribe first, snapshot second, dedupe by id"
   ]
  },
  {
   "dot": "rose",
   "title": "Interrupt + Failure",
   "items": [
    "Interrupt bypasses the queue and preempts",
    "Both cancellation events are co-emitted",
    "A failed session keeps its transcript for inspection"
   ]
  }
 ]
